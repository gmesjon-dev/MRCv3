{
  "name": "grupo-mrc-digital",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "dist/client" },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mrc-digital-db",
      "database_id": "4eee6a67-8175-48de-8eee-e9f556b63822",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "mrc-digital-files"
    }
  ],
  "vars": {
    "CF_ACCESS_TEAM_DOMAIN": "damp-scene-2279.cloudflareaccess.com",
    "CF_ACCESS_AUD": "116fbc089d7455a6d9b606034d13c2df1b5a0e9d2d3f4b5c9d12221063922233"
  }
}
